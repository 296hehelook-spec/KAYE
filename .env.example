# ==============================================================================
# Kaye AlumniFinder - Environment Configuration
# ==============================================================================

# Search & AI API Keys (Server-side only)
GEMINI_API_KEY="your-gemini-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
GOOGLE_API_KEY="your-google-custom-search-api-key"
GOOGLE_CSE_ID="your-programmable-search-engine-id"
ANTHROPIC_API_KEY="your-anthropic-claude-api-key"

# Agent Security Secret
AGENT_SECRET="kaye_agent_secure_token_change_in_production"

# Supabase PostgreSQL Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-private-key"

# Redis Cache (Optional, fallback to Postgres search_cache table)
REDIS_URL="rediss://default:your-password@your-endpoint.upstash.io:6379"

# Mock Mode (Set to "true" to test the full UI without external API billing)
VITE_MOCK_MODE="true"
